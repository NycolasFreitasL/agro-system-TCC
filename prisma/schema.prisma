/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plantio {
  id_plantio          Int            @id(map: "pk_plantio") @default(autoincrement())
  id_lote             Int
  id_produto          Int
  data_plantio        DateTime       @db.Date
  prev_colheita       DateTime?      @db.Date
  quantidade_plantada Decimal        @db.Decimal(10, 2)
  status_plantio      String         @db.VarChar(20)
  id_usuario          Int
  colheita            colheita[]
  fertilizacao        fertilizacao[]
  irrigacao           irrigacao[]
  lote                lote           @relation(fields: [id_lote], references: [id_lote], onDelete: NoAction, onUpdate: NoAction, map: "fk_plantio_lote")
  produto             produto        @relation(fields: [id_produto], references: [id_produto], onDelete: NoAction, onUpdate: NoAction, map: "fk_plantio_produto")
  usuarios            usuarios       @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_plantio_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model produto {
  id_produto     Int            @id(map: "pk_produto") @default(autoincrement())
  nome_produto   String         @db.VarChar(100)
  categoria      String         @db.VarChar(40)
  quantidade     Decimal        @default(0) @db.Decimal(10, 2)
  estoque_min    Decimal        @default(0) @db.Decimal(10, 2)
  unidade_medida String         @db.VarChar(20)
  criado_em      DateTime?      @default(now()) @db.Timestamp(6)
  atualizado_em  DateTime?      @default(now()) @db.Timestamp(6)
  alimentacao    alimentacao[]
  fertilizacao   fertilizacao[]
  move_estoque   move_estoque[]
  plantio        plantio[]
  vacinacao      vacinacao[]
}

model usuarios {
  id_usuario        Int            @id @default(autoincrement())
  nome_usuario      String         @db.VarChar(100)
  email             String         @unique(map: "uq_usuario_email") @db.VarChar(150)
  senha             String         @db.VarChar(250)
  permissao_usuario String         @default("FUNCIONARIO") @db.VarChar(20)
  criado_em         DateTime?      @default(now()) @db.Timestamptz(6)
  foto_perfil       String?        @db.VarChar(255)
  atualizado_em     DateTime?      @default(now()) @db.Timestamp(6)
  alimentacao       alimentacao[]
  colheita          colheita[]
  fertilizacao      fertilizacao[]
  irrigacao         irrigacao[]
  move_estoque      move_estoque[]
  plantio           plantio[]
  vacinacao         vacinacao[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
