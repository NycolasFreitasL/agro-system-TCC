generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alimentacao {
  id_alimentacao         Int      @id(map: "pk_alimentacao") @default(autoincrement())
  id_animal              Int
  id_produto             Int
  data_alimentacao       DateTime @db.Date
  quantidade_alimentacao Decimal  @db.Decimal(10, 2)
  observacao             String?  @db.VarChar(255)
  id_usuario             Int
  animal                 animal   @relation(fields: [id_animal], references: [id_animal], onDelete: NoAction, onUpdate: NoAction, map: "fk_alimentacao_animal")
  produto                produto  @relation(fields: [id_produto], references: [id_produto], onDelete: NoAction, onUpdate: NoAction, map: "fk_alimentacao_produto")
  usuarios               usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_alimentacao_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model animal {
  id_animal       Int           @id(map: "pk_animal") @default(autoincrement())
  id_especie      Int
  nome_animal     String        @db.VarChar(100)
  raca_animal     String?       @db.VarChar(60)
  sexo_animal     String        @db.Char(1)
  data_nascimento DateTime?     @db.Date
  peso_animal     Decimal?      @db.Decimal(6, 2)
  saude_animal    String?       @db.VarChar(50)
  foto_animal     String?       @db.VarChar(255)
  criado_em       DateTime?     @default(now()) @db.Timestamp(6)
  atualizado_em   DateTime?     @default(now()) @db.Timestamp(6)
  status_animal   String        @default("ATIVO") @db.VarChar(20)
  alimentacao     alimentacao[]
  especie         especie       @relation(fields: [id_especie], references: [id_especie], onDelete: NoAction, onUpdate: NoAction, map: "fk_animal_especie")
  vacinacao       vacinacao[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model colheita {
  id_colheita         Int      @id(map: "pk_colheita") @default(autoincrement())
  id_plantio          Int
  data_colheita       DateTime @db.Date
  quantidade_colheita Decimal  @db.Decimal(10, 2)
  unidade_medida      String   @db.VarChar(20)
  observacao          String?  @db.VarChar(255)
  id_usuario          Int
  plantio             plantio  @relation(fields: [id_plantio], references: [id_plantio], onDelete: NoAction, onUpdate: NoAction, map: "fk_colheita_plantio")
  usuarios            usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_colheita_usuario")
}

model especie {
  id_especie    Int       @id(map: "pk_especie") @default(autoincrement())
  nome_especie  String    @db.VarChar(60)
  status        String    @db.VarChar(20)
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  atualizado_em DateTime? @default(now()) @db.Timestamp(6)
  animal        animal[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fertilizacao {
  id_fertilizacao         Int      @id(map: "pk_fertilizacao") @default(autoincrement())
  id_plantio              Int
  id_produto              Int
  data_fertilizacao       DateTime @db.Date
  quantidade_fertilizacao Decimal  @db.Decimal(10, 2)
  observacao              String?  @db.VarChar(255)
  id_usuario              Int
  plantio                 plantio  @relation(fields: [id_plantio], references: [id_plantio], onDelete: NoAction, onUpdate: NoAction, map: "fk_fertilizacao_plantio")
  produto                 produto  @relation(fields: [id_produto], references: [id_produto], onDelete: NoAction, onUpdate: NoAction, map: "fk_fertilizacao_produto")
  usuarios                usuarios @relation(fields: [id_usuario], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_fertilizacao_usuario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model irrigacao {
  id_irrigacao    Int      @id(map: "pk_irrigacao") @default(autoincrement())
  id_plantio      Int
  data_irrigacao  DateTime @db.Date
  quantidade_agua Decimal  @db.Decimal(10, 2)
  unidade_medida  String   @db.VarChar(10)
  observacao      String?  @db.VarChar(255)
  id_usuario      Int
