  area          Decimal   @db.Decimal(10, 2)
  prev_colheita DateTime? @db.Date
  status_lote   String    @db.VarChar(20)
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  atualizado_em DateTime? @default(now()) @db.Timestamp(6)
  plantio       plantio[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model move_estoque {
  id_movimentacao   Int      @id(map: "pk_movimentacao_estoque") @default(autoincrement())
  id_produto        Int
  tipo_movimento    String   @db.VarChar(20)
  quantidade_move   Decimal  @db.Decimal(10, 2)
  data_movimentacao DateTime @default(now()) @db.Timestamptz(6)
  observacao        String?  @db.VarChar(255)
  id_usuario        Int
